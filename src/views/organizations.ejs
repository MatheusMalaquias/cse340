<%- include("partials/header") %>

<main class="page-content">
  <section class="page-intro">
    <h1>Find Your Community</h1>
    <p>
      Connect with people who share your interests,
      exchange knowledge, and grow together.
    </p>
  </section>

  <section class="organizations-section container">
    <div class="section-heading">
      <h2>Explore Communities</h2>
      <p>Find your people. Share what you know. Learn something new.</p>
    </div>

    <div class="organization-grid">
      <% organizations.forEach((organization) => { %>
        <article class="organization-card">
          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
          >

          <div class="card-content">
            <h3><%= organization.name %></h3>

            <p><%= organization.description %></p>

            <p>
              <strong>Contact:</strong>
              <a href="mailto:<%= organization.contact_email %>" class="card-link">
                <%= organization.contact_email %>
              </a>
            </p>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
