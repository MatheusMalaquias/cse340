<%- include("partials/header") %>

<main class="page-content">
  <section class="page-intro">
    <h1><%= title %></h1>
    <p><a href="/organizations" class="back-link">&larr; All organizations</a></p>
  </section>

  <section class="detail-section container">
    <article class="detail-card">
      <img
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.name %> logo"
        class="detail-image"
      >

      <p><%= organizationDetails.description %></p>

      <p>
        <strong>Contact:</strong>
        <a href="mailto:<%= organizationDetails.contact_email %>">
          <%= organizationDetails.contact_email %>
        </a>
      </p>
    </article>

    <h2 class="section-title">Service Projects</h2>

    <% if (projects.length === 0) { %>
      <p class="empty-message">This organization has no service projects yet.</p>
    <% } else { %>
      <ul class="link-list">
        <% projects.forEach((project) => { %>
          <li>
            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
            <span class="list-meta">
              <%= project.project_date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
